---
// The full product demo (Product Demo page), recorded by
// frontend/docs-screenshots/product-demo-video.spec.ts and served from this
// site, so the page makes no third-party request. astro:assets doesn't handle
// video, hence ?url.
import { getImage } from 'astro:assets';
import demoWebm from '../../assets/demo/product-demo.webm?url';
import demoMp4 from '../../assets/demo/product-demo.mp4?url';
import posterFrame from '../../assets/demo/product-demo-poster.png';

const poster = await getImage({ src: posterFrame, width: 1280, format: 'webp' });
---

<div class="frame landing-ink not-content">
	<video
		controls
		playsinline
		preload="metadata"
		poster={poster.src}
		width="1280"
		height="720"
		aria-label="ActionsManager product demo: sign in with a personal access token, create a Caller Workflow Project for three repositories, detect their build types, open a pull request in each, and merge them."
	>
		<source src={demoWebm} type="video/webm" />
		<source src={demoMp4} type="video/mp4" />
		<a href={demoMp4}>Download the demo video (MP4)</a>
	</video>
</div>

<style>
	/* landing-ink keeps the frame dark in light mode, as on the home page. */
	.frame {
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.75rem;
		overflow: hidden;
		background: var(--sl-color-gray-6);
	}
	video {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
